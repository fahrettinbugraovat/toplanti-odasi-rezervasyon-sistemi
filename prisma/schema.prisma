generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  fullName      String        
  email         String        @unique
  password      String        
  
  // PROFİL SAYFASI İÇİN ALANLAR
  username      String?       @unique
  phone         String?       
  avatarUrl     String?       
  
  role          Role          @default(USER)
  
  reservations  Reservation[] 
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Room {
  id            String        @id @default(cuid()) 
  name          String        
  capacity      String        
  features      String[]      
  status        String        @default("Müsait") 
  
  reservations  Reservation[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Reservation {
  id               String            @id @default(cuid())
  title            String            
  
  startTime        DateTime
  endTime          DateTime
  
  status           ReservationStatus @default(ACTIVE) 
  
  // ONAY SÜRECİ İÇİN GEÇİCİ DEĞİŞİKLİK ALANLARI
  pendingStartTime DateTime?    
  pendingEndTime   DateTime?    
  pendingTitle     String?      
  
  room             Room              @relation(fields: [roomId], references: [id])
  roomId           String
  
  // KULLANICI SAHİPLİĞİ (OWNERSHIP) ALANLARI
  user             User              @relation(fields: [userId], references: [id])
  userId           String

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum ReservationStatus {
  ACTIVE    
  PENDING
  CANCELLED
  COMPLETED
}